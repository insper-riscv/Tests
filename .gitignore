__pycache__/
*.pyc
build/
build-sdram/
cache/
sim_build/
.venv/
# Per-kind run history (real/sim/certification) — see
# riscv_tools.run_log. Local-only, kept around across `compile`
# wiping build/ (unlike build/, never auto-cleaned).
logs/
# Generated by `riscv-tools generate-header` from memory.mailbox_addr
# in config.yaml — not hand-maintained, regenerate instead of editing.
tools/riscv_build/include/rv32_test.h
tools/riscv_build/include-sdram/rv32_test.h
# Checked-in .hex fixtures for the instruction-level cocotb tests
# (see tests/python/unittests/instructions/) — the bare `build/` rule
# above would otherwise swallow this one, ported from RV32IM's own
# .gitignore which carries the same exception.
!tests/python/unittests/instructions/codes/build/